# Copie para .env e preencha. O .env não vai para o Git.

# --- Banco ---
MYSQL_DATABASE=orcamento
MYSQL_USER=app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Provedor de IA (escolha UM bloco) ---

# Opção A: Groq (plano gratuito). Crie a chave em https://console.groq.com
# A Groq não gera voz em português: deixe a fala desligada (a resposta vem em texto).
# Confira os modelos atuais em https://console.groq.com/docs/models
# Modelos de raciocínio (openai/gpt-oss-*) exigem AI_SEM_RACIOCINIO=true: sem isso a Groq recusa o campo reasoning_content (erro 400).
# Os modelos disponíveis variam por conta: liste os da sua com GET https://api.groq.com/openai/v1/models
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_CHAT_MODEL=openai/gpt-oss-20b
AI_SEM_RACIOCINIO=true
AI_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
FALA_HABILITADA=false

# Opção B: OpenAI (pago). Troque o bloco acima por:
# AI_API_KEY=sua-chave-da-openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_CHAT_MODEL=gpt-4o-mini
# AI_TRANSCRIPTION_MODEL=whisper-1
# FALA_HABILITADA=true
